# Database (Neon Postgres). Leave unset for MSW / offline local development.
DATABASE_URL=

# Auth.js (staff back-office) — required when auth is implemented.
AUTH_SECRET=

# SMTP (SekoFund pattern) — transactional email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Paystack — donation checkout + webhook verification.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# S3-compatible object storage for media library.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Client-visible mock flags (never put secrets here).
NEXT_PUBLIC_MOCK_API=true
NEXT_PUBLIC_ENABLE_MSW=true
