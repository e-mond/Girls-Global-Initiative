# Database (Neon Postgres). Leave unset for MSW / offline local development.
DATABASE_URL=

# Auth.js (staff back-office) — required.
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# Offline/local bootstrap staff account (ignored in production when DATABASE_URL is set).
AUTH_DEV_EMAIL=staff@ggi.local
AUTH_DEV_PASSWORD=ggi-local-dev-password
AUTH_DEV_NAME=Local Administrator
AUTH_DEV_ROLE=administrator

# SMTP (SekoFund pattern) — transactional email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Paystack — donation checkout + webhook verification.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional override; defaults to PAYSTACK_SECRET_KEY for HMAC verification.
PAYSTACK_WEBHOOK_SECRET=

# Organisation direct-transfer details shown on the donate page.
ORG_BANK_NAME=
ORG_ACCOUNT_NAME=
ORG_ACCOUNT_NUMBER=
ORG_MOBILE_MONEY=
ORG_TRANSFER_NOTES=

# S3-compatible object storage — superseded for GGI media by Cloudinary.
# Kept for reference only; do not use for new media uploads.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Cloudinary — media library (images and videos). Details pending from owner.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ggi

# Client-visible mock flags (never put secrets here).
NEXT_PUBLIC_MOCK_API=true
NEXT_PUBLIC_ENABLE_MSW=true
