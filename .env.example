# Database (Neon Postgres). Leave unset for MSW / offline local development.
DATABASE_URL=

# Auth.js (staff back-office) — required.
AUTH_SECRET=replace-with-a-long-random-string
# Local: http://localhost:3000 — Production: https://girlsglobalinitiative.org
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Offline/local bootstrap staff account (ignored in production when DATABASE_URL is set).
AUTH_DEV_EMAIL=staff@ggi.local
AUTH_DEV_PASSWORD=ggi-local-dev-password
AUTH_DEV_NAME=Local Administrator
AUTH_DEV_ROLE=administrator

# Production / Neon admin seed (preferred over AUTH_DEV_* when seeding).
# SEED_ADMIN_EMAIL=admin@girlsglobalinitiative.org
# SEED_ADMIN_PASSWORD=use-a-long-random-password
# SEED_ADMIN_NAME=Site Administrator
# SEED_ADMIN_UPDATE_PASSWORD=1
# Then: npm run db:seed-admin
# Change later via /admin/forgot-password (SMTP required) or re-seed with UPDATE_PASSWORD=1.

# SMTP (SekoFund pattern) — transactional email (staff invites, newsletter).
# SMTP_FROM mailbox must match SMTP_USER (authenticated account).
# Gmail consumer SMTP often lands in spam for org-branded mail — prefer a
# domain-authenticated ESP (see docs/CLOUDFLARE.md → Email deliverability).
# Gmail interim: SMTP_HOST=smtp.gmail.com + app password for SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=girlsglobalinitiative@gmail.com
SMTP_PASS=
SMTP_FROM=Girls Global Initiative <girlsglobalinitiative@gmail.com>
# Optional; defaults to the mailbox inside SMTP_FROM.
SMTP_REPLY_TO=girlsglobalinitiative@gmail.com

# One-shot site-live subscriber blast (operator script — not Worker).
# Do NOT full-blast from @gmail.com until SPF/DKIM/DMARC domain mail is live.
#   npm run db:publish-site-live-news
#   ANNOUNCE_DRY_RUN=1 npm run announce:site-live
#   npm run announce:site-live
# ANNOUNCE_LIMIT=5
# ANNOUNCE_DRY_RUN=1

# Paystack — donation checkout + webhook verification.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional override; defaults to PAYSTACK_SECRET_KEY for HMAC verification.
PAYSTACK_WEBHOOK_SECRET=

# Organisation direct-transfer details shown on the donate page.
# Leave blank until GGI supplies official values — never invent numbers.
ORG_BANK_NAME=
ORG_ACCOUNT_NAME=
ORG_ACCOUNT_NUMBER=
ORG_MOBILE_MONEY=
# Optional narration / reference instruction shown to donors.
ORG_TRANSFER_NOTES=

# S3-compatible object storage — superseded for GGI media by Cloudinary.
# Kept for reference only; do not use for new media uploads.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Cloudinary — media library (images and videos). Details pending from owner.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ggi

# Client-visible mock flags (never put secrets here).
NEXT_PUBLIC_MOCK_API=true
NEXT_PUBLIC_ENABLE_MSW=true
