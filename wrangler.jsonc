{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "girls-global-initiative",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Must match "name" above — never package.json "ggi".
      "service": "girls-global-initiative"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Non-secret runtime config. Secrets (AUTH_SECRET, DATABASE_URL, SMTP_*, …)
  // must be set in Cloudflare Worker Settings → Variables and Secrets.
  "vars": {
    "AUTH_URL": "https://girlsglobalinitiative.org",
    "NEXT_PUBLIC_SITE_URL": "https://girlsglobalinitiative.org",
    "NEXT_PUBLIC_ENABLE_MSW": "false",
    "NEXT_PUBLIC_MOCK_API": "false"
  },
  // Required when Cloudflare dashboard runs `wrangler preview`.
  // Production deploy must still be: npx opennextjs-cloudflare deploy
  "previews": {
    "images": {
      "binding": "IMAGES"
    }
  },
  "observability": {
    "enabled": true
  }
}
